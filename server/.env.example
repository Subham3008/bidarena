# Core server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Required in production. Add exact frontend origins, comma-separated.
CLIENT_URLS=http://localhost:5173
MAX_BID_AMOUNT=1000000000

MONGODB_URI=your_mongodb_connection_string

JWT_ACCESS_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=15m
# Use none only for HTTPS frontend/backend on different sites.
SESSION_COOKIE_SAME_SITE=lax

# Required only for the auction-image upload endpoint
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Required only for winner payment endpoints; test-mode keys only
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
